    m_Metadata:
      m_Items: []
  - m_Id: 17449095947464704
    m_Key: "\u042D\u0442\u043E \u2013 \u043A\u0438\u0456\u0437. \u041E\u043D \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
      \u043E\u0442 \u0436\u0430\u0440\u044B \u0438 \u0445\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 17490494310952960
    m_Key: "\u042D\u0442\u043E \u2013 \u043A\u043E\u043F\u044C\u0435, \u043A\u043E\u043B\u044E\u0449\u0435\u0435
      \u043E\u0440\u0443\u0436\u0438\u0435! \u0425\u043E\u0447\u0435\u0448\u044C
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u044C
      \u0435\u0433\u043E? \u041A\u043E\u043F\u044C\u0435 \u0431\u044B\u043B\u043E
      \u043D\u0430\u0434\u0435\u0436\u043D\u044B\u043C \u043E\u0440\u0443\u0436\u0438\u0435\u043C
      \u0433\u0435\u0440\u043E\u0435\u0432. \u0422\u044B \u0445\u043E\u0447\u0435\u0448\u044C
      \u0441\u0442\u0430\u0442\u044C \u0433\u0435\u0440\u043E\u0435\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0431\u0443\u0434\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043A\u043E\u043F\u044C\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 17490499763548160
    m_Key: "\u042D\u0442\u043E \u2013 \u043B\u0443\u043A! \u041D\u0430\u0448\u0438
      \u043F\u0440\u0435\u0434\u043A\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438
      \u043B\u0443\u043A \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u044B. \u0422\u044B
      \u043C\u043E\u0436\u0435\u0448\u044C \u0442\u043E\u0447\u043D\u043E \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u0446\u0435\u043B\u044C? \u0414\u0430\u0432\u0430\u0439, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 17497164625850368
    m_Key: "\u042D\u0442\u043E \u2013 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430. \u041D\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u0445
      \u043C\u043D\u043E\u0433\u043E \u0437\u043D\u0430\u043A\u043E\u0432. \u0423
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0437\u043D\u0430\u043A\u0430 \u0435\u0441\u0442\u044C
      \u0441\u0432\u043E\u044F \u0442\u0430\u0439\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 17449033460723712
    m_Key: "\u042D\u0442\u043E \u2013 \u0443\u044B\u049B. \u041E\u043D \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442
      \u043A\u0435\u0440\u0435\u0433\u0435 \u0438 \u0448\u0430\u04A3\u044B\u0440\u0430\u049B.
      \u0414\u0430\u0432\u0430\u0439 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u0438\u043C
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u044B\u049B \u043A \u0448\u0430\u04A3\u044B\u0440\u0430\u043A\u0443
      \u0438 \u043A\u0435\u0440\u0435\u0433\u0435. \u041E\u0442\u043B\u0438\u0447\u043D\u043E!
      \u0428\u0430\u04A3\u044B\u0440\u0430\u049B \u0441\u0442\u043E\u0438\u0442 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 75367237826490368
    m_Key: "\xAB\u0413\u043E\u043B\u043E\u0441 \u0410\u0437\u0438\u0438\xBB \u2014
      \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u043E-\u0445\u0443\u0434\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0430, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u044E\u0449\u0430\u044F
      \u0442\u0430\u043B\u0430\u043D\u0442\u043B\u0438\u0432\u044B\u0445 \u043F\u0435\u0432\u0446\u043E\u0432
      \u0438\u0437 \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0442\u0440\u0430\u043D.
      \u0421\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u043D\u0438\u043C
      \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u043F\u0440\u0435\u0441\u0442\u0438\u0436\u043D\u044B\u0445

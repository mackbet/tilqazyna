    - target: {fileID: 4420244195531666729, guid: d230053f974381c45b7bc3547eb1787f, type: 3}
      propertyPath: m_text
      value: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0438 \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u044C
        \u0441 \u043D\u0438\u043C \u0447\u0435\u0442\u044B\u0440\u0435 \u0433\u043B\u0430\u0432\u043D\u044B\u0445
        \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430, \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u044F
        \u0438\u043B\u0438 \u0438\u0437\u0434\u0435\u043B\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B \u0435\u043C\u0443
        \u0434\u043B\u044F \u0435\u0433\u043E \u0434\u0435\u043B\u0430."

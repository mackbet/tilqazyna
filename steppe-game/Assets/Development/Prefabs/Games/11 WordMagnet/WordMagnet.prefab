    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[0].text
      value: "\u0421\u04D9\u043B\u0435\u043C, \u0436\u0430\u0441 \u0441\u0430\u044F\u0445\u0430\u0442\u0448\u044B!
        \u0411\u0456\u0437 \u0430\u04A3\u044B\u0437\u0434\u0430\u0440 \u0435\u043B\u0456
        \u2013 \u0411\u0430\u044F\u043D\u0430\u0443\u044B\u043B\u0434\u044B\u04A3
        \u0435\u04A3 \u043C\u04E9\u043B\u0434\u0456\u0440 \u0436\u04D9\u043D\u0435
        \u0442\u0430\u0443\u043B\u044B \u0436\u043E\u0442\u0430\u043B\u0430\u0440\u0434\u044B\u04A3
        \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430 \u043E\u0440\u043D\u0430\u043B\u0430\u0441\u049B\u0430\u043D
        \u2014 \u0416\u0430\u0441\u044B\u0431\u0430\u0439 \u043A\u04E9\u043B\u0456\u043D\u0434\u0435\u043C\u0456\u0437."
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[1].text
      value: "\u0410\u04A3\u044B\u0437 \u0431\u043E\u0439\u044B\u043D\u0448\u0430,
        \u043A\u04E9\u043B\u0434\u0456 \u049B\u0430\u0437\u0430\u049B \u0431\u0430\u0442\u044B\u0440\u044B
        \u0416\u0430\u0441\u044B\u0431\u0430\u0439\u0434\u044B\u04A3 \u049B\u04B1\u0440\u043C\u0435\u0442\u0456\u043D\u0435
        \u0430\u0442\u0430\u0493\u0430\u043D, \u043E\u043B \u0436\u0430\u0443 \u0431\u0430\u0441\u049B\u044B\u043D\u0448\u044B\u043B\u0430\u0440\u043C\u0435\u043D
        \u0448\u0430\u0439\u049B\u0430\u0441\u0442\u0430 \u0436\u0430\u0493\u0430\u043B\u0430\u0443\u0434\u0430
        \u049B\u0430\u0437\u0430 \u0442\u0430\u043F\u049B\u0430\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[2].text
      value: "\u0415\u0440\u0435\u0436\u0435 \u049B\u0430\u0440\u0430\u043F\u0430\u0439\u044B\u043C, 
        \u0421\u04E9\u0437 \u043C\u0430\u0433\u043D\u0438\u0442\u0456 \u0437\u0430\u0442
        \u0435\u0441\u0456\u043C , \u0441\u044B\u043D \u0435\u0441\u0456\u043C, \u04AF\u0441\u0442\u0435\u0443
        \u0436\u04D9\u043D\u0435 \u0442\u0430\u0493\u044B \u0434\u0430 \u0431\u0430\u0441\u049B\u0430
        \u0431\u043E\u043B\u0443\u044B \u043C\u04AF\u043C\u043A\u0456\u043D , \u043C\u0430\u0433\u043D\u0438\u0442
        \u0430\u0440\u049B\u044B\u043B\u044B \u0434\u04B1\u0440\u044B\u0441 \u0441\u04E9\u0437\u0434\u0435\u0440\u0434\u0456
        \u0436\u0438\u043D\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[3].text

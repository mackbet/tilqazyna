      propertyPath: _facts.Array.data[15].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \xAB\u041E\u049B\u0436\u0435\u0442\u043F\u0435\u0441\xBB

    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[0].text
      value: "\u0421\u04D9\u043B\u0435\u043C, \u0441\u0430\u044F\u0445\u0430\u0442\u0448\u044B!\n\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u044B\u04A3
        \u0441\u0438\u049B\u044B\u0440\u043B\u044B \u043C\u04B1\u0437\u0434\u044B
        \u0430\u043B\u0430\u04A3\u044B\u043D\u0430 \u049B\u043E\u0448 \u043A\u0435\u043B\u0434\u0456\u04A3!\n"
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[1].text
      value: "\xAB\u041C\u04B1\u0437 \u0431\u0438\u0456\xBB \u043E\u0439\u044B\u043D\u044B\u043D\u0434\u0430
        \u043A\u043E\u043D\u044C\u043A\u0438\u043C\u0435\u043D \u0441\u044B\u0440\u0493\u0430\u043D\u0430\u043F,
        \u0441\u04E9\u0437\u0434\u0435\u0440\u0434\u0456 \u0436\u0438\u043D\u0430
        \u0434\u0430, \u043E\u043B\u0430\u0440\u0434\u0430\u043D \u0434\u04B1\u0440\u044B\u0441
        \u0441\u04E9\u0439\u043B\u0435\u043C \u049B\u04B1\u0440\u0430\u0441\u0442\u044B\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 7397679988174239180, guid: a4f30e8ce95939b488ce10ae98859220, type: 3}
      propertyPath: dialogueEntries.Array.data[2].text
      value: "\u0428\u0430\u043F\u0448\u0430\u04A3\u0434\u044B\u049B \u043F\u0435\u043D
        \u0437\u0435\u0439\u0456\u043D \u2014 \u0436\u0435\u04A3\u0456\u0441\u0442\u0456\u04A3
        \u043A\u0456\u043B\u0442\u0456!\n\u0421\u04D9\u0442\u0442\u0456\u043B\u0456\u043A
        \u0442\u0456\u043B\u0435\u0439\u043C\u0456\u0437!"
      objectReference: {fileID: 0}

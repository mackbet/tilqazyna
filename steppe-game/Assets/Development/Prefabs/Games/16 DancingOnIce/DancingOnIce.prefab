    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[14].text
      value: "\u0411\u04B1\u043B \u0430\u0439\u043C\u0430\u049B\u0442\u0430 \u049B\u043E\u043D\u0430\u049B

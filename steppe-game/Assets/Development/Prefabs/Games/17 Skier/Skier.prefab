    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[0].text
      value: "\u041C\u0435\u043D \u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430
        \u0436\u0438\u0456 \u0431\u0430\u0440\u0430\u043C\u044B\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[1].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439 - \u04E9\u0442\u0435 \u04D9\u0434\u0435\u043C\u0456
        \u0436\u0435\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[2].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \u04AF\u043B\u043A\u0435\u043D
        \u043A\u04E9\u043B \u0431\u0430\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[3].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \u049B\u0430\u043B\u044B\u04A3
        \u043E\u0440\u043C\u0430\u043D \u0431\u0430\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[4].text
      value: "\u0422\u0430\u0443\u043B\u0430\u0440 \u0430\u043B\u044B\u0441\u0442\u0430\u043D
        \u043A\u04E9\u0440\u0456\u043D\u0456\u043F \u0442\u04B1\u0440\u0430\u0434\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[5].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \u0434\u0435\u043C\u0430\u043B\u044B\u0441
        \u043E\u0440\u044B\u043D\u0434\u0430\u0440\u044B \u043A\u04E9\u043F."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[6].text
      value: "\u0421\u0430\u044F\u0445\u0430\u0442\u0448\u044B\u043B\u0430\u0440
        \u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430 \u0436\u0430\u0437\u0434\u0430
        \u043A\u04E9\u043F \u043A\u0435\u043B\u0435\u0434\u0456."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[7].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439 \u049B\u044B\u0441\u0442\u0430
        \u0434\u0430 \u0441\u04B1\u043B\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[8].text
      value: "\u0411\u0456\u0437 \u043A\u04E9\u043B \u0436\u0430\u0493\u0430\u0441\u044B\u043D\u0434\u0430
        \u0434\u0435\u043C\u0430\u043B\u0430\u043C\u044B\u0437."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[9].text
      value: "\u0411\u04B1\u043B \u0436\u0435\u0440 \u0430\u0434\u0430\u043C\u0493\u0430
        \u0442\u044B\u043D\u044B\u0448\u0442\u044B\u049B \u0441\u044B\u0439\u043B\u0430\u0439\u0434\u044B."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[10].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430 \u0434\u043E\u0441\u0442\u0430\u0440\u044B\u043C\u043C\u0435\u043D
        \u0431\u0430\u0440\u0493\u0430\u043D\u0434\u044B \u04B1\u043D\u0430\u0442\u0430\u043C\u044B\u043D."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[11].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u044B \u0431\u04D9\u0440\u0456
        \u0436\u0430\u049B\u0441\u044B \u043A\u04E9\u0440\u0435\u0434\u0456."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[12].text
      value: "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u044B\u04A3 \u0430\u0443\u0430\u0441\u044B
        \u0442\u0430\u0437\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[13].text
      value: "\u041A\u04E9\u043B\u0434\u0456\u04A3 \u0430\u0439\u043D\u0430\u043B\u0430\u0441\u044B\u043D\u0434\u0430
        \u043A\u04E9\u043F \u049B\u043E\u043D\u0430\u049B\u04AF\u0439 \u0431\u0430\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[14].text
      value: "\u041C\u04B1\u043D\u0434\u0430 \u0431\u0430\u043B\u0430\u043B\u0430\u0440\u0493\u0430
        \u0430\u0440\u043D\u0430\u043B\u0493\u0430\u043D \u043E\u0439\u044B\u043D
        \u0430\u043B\u0430\u04A3\u044B \u0431\u0430\u0440."
      objectReference: {fileID: 0}
    - target: {fileID: 8545990266414729277, guid: 3104ecf3cc0b3f447af3e517940aab79, type: 3}
      propertyPath: _facts.Array.data[15].text
      value: "\u0416\u04B1\u043C\u0431\u0430\u049B\u0442\u0430\u0441 \u043A\u04E9\u043B\u0434\u0456\u04A3

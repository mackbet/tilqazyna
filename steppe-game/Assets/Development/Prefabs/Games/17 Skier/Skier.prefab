--- !u!114 &3842555983546218454
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4472390453735148813}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 596d3704152be6945972a3cf7384958d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WordSpawner
  wordsContainer: {fileID: 6263831139014385201}
  wordContainerPrefab: {fileID: 1264275253057694963, guid: afddac6ac17b2fb4d9f17645f8816550, type: 3}
  resultPanel: {fileID: 2481643983713262605}
  resultField: {fileID: 348059062230171141}
  sentences:
  - "\u041C\u0435\u043D \u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430 \u0436\u0438\u0456
    \u0431\u0430\u0440\u0430\u043C\u044B\u043D."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \u04AF\u043B\u043A\u0435\u043D
    \u043A\u04E9\u043B \u0431\u0430\u0440."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \u049B\u0430\u043B\u044B\u04A3
    \u043E\u0440\u043C\u0430\u043D \u0431\u0430\u0440."
  - "\u0422\u0430\u0443\u043B\u0430\u0440 \u0430\u043B\u044B\u0441\u0442\u0430\u043D
    \u043A\u04E9\u0440\u0456\u043D\u0456\u043F \u0442\u04B1\u0440\u0430\u0434\u044B."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u0430 \u0434\u0435\u043C\u0430\u043B\u044B\u0441
    \u043E\u0440\u044B\u043D\u0434\u0430\u0440\u044B \u043A\u04E9\u043F."
  - "\u0421\u0430\u044F\u0445\u0430\u0442\u0448\u044B\u043B\u0430\u0440 \u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430
    \u0436\u0430\u0437\u0434\u0430 \u043A\u04E9\u043F \u043A\u0435\u043B\u0435\u0434\u0456."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439 \u049B\u044B\u0441\u0442\u0430 \u0434\u0430
    \u0441\u04B1\u043B\u0443."
  - "\u0411\u0456\u0437 \u043A\u04E9\u043B \u0436\u0430\u0493\u0430\u0441\u044B\u043D\u0434\u0430
    \u0434\u0435\u043C\u0430\u043B\u0430\u043C\u044B\u0437."
  - "\u0411\u04B1\u043B \u0436\u0435\u0440 \u0430\u0434\u0430\u043C\u0493\u0430 \u0442\u044B\u043D\u044B\u0448\u0442\u044B\u049B
    \u0441\u044B\u0439\u043B\u0430\u0439\u0434\u044B."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430 \u0434\u043E\u0441\u0442\u0430\u0440\u044B\u043C\u043C\u0435\u043D
    \u0431\u0430\u0440\u0493\u0430\u043D\u0434\u044B \u04B1\u043D\u0430\u0442\u0430\u043C\u044B\u043D."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u044B \u0431\u04D9\u0440\u0456
    \u0436\u0430\u049B\u0441\u044B \u043A\u04E9\u0440\u0435\u0434\u0456."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0434\u044B\u04A3 \u0430\u0443\u0430\u0441\u044B
    \u0442\u0430\u0437\u0430."
  - "\u041A\u04E9\u043B\u0434\u0456\u04A3 \u0430\u0439\u043D\u0430\u043B\u0430\u0441\u044B\u043D\u0434\u0430
    \u043A\u04E9\u043F \u049B\u043E\u043D\u0430\u049B\u04AF\u0439 \u0431\u0430\u0440."
  - "\u041C\u04B1\u043D\u0434\u0430 \u0431\u0430\u043B\u0430\u043B\u0430\u0440\u0493\u0430
    \u0430\u0440\u043D\u0430\u043B\u0493\u0430\u043D \u043E\u0439\u044B\u043D \u0430\u043B\u0430\u04A3\u044B
    \u0431\u0430\u0440."
  - "\u0416\u04B1\u043C\u0431\u0430\u049B\u0442\u0430\u0441 \u043A\u04E9\u043B\u0434\u0456\u04A3
    \u043E\u0440\u0442\u0430\u0441\u044B\u043D\u0434\u0430 \u043E\u0440\u043D\u0430\u043B\u0430\u0441\u049B\u0430\u043D."
  - "\u0416\u04B1\u043C\u0431\u0430\u049B\u0442\u0430\u0441 \u0442\u0443\u0440\u0430\u043B\u044B
    \u0430\u04A3\u044B\u0437 \u043A\u04E9\u043F."
  - "\u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430 \u0431\u0430\u0440\u0441\u0430\u04A3,
    \u043C\u0438\u044B\u04A3 \u0442\u044B\u043D\u044B\u0493\u0430\u0434\u044B."
  - "\u0414\u0435\u043C\u0430\u043B\u044B\u0441 \u0431\u043E\u043B\u0441\u0430, \u0411\u0443\u0440\u0430\u0431\u0430\u0439\u0493\u0430
    \u0431\u0430\u0440\u0493\u0430\u043D \u0434\u04B1\u0440\u044B\u0441."
  - "\u041E\u049B\u0436\u0435\u0442\u043F\u0435\u0441\u0442\u0456\u04A3 \u0431\u0438\u0456\u043A\u0442\u0456\u0433\u0456
    \u043C\u044B\u04A3 \u043C\u0435\u0442\u0440\u0434\u0435\u043D \u0430\u0441\u0430\u0434\u044B."
  spawnInterval: 5
  minSpawnInterval: 5
  maxSpawnInterval: 6
  useRandomInterval: 1
  wordSpeed: 1000
  minYNormalized: 0.25
  maxYNormalized: 0.75

  m_Script: {fileID: 11500000, guid: d38ec61df62fb354b838ebcec8f48a86, type: 3}
  m_Name: Question 14
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionSimple
  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B\u0434\u0435\u043D \u0431\u0430\u0441\u0442\u0430\u0443
      \u0430\u043B\u0430\u0442\u044B\u043D \u04E9\u0437\u0435\u043D\u0434\u0435\u0440
      \u0431\u0430\u0440 \u043C\u0430?"
    audioClip: {fileID: 0}
  <Answers>k__BackingField:
  - text: "\u0418\u04D9, \u0431\u0456\u0440\u043D\u0435\u0448\u0435 \u0456\u0440\u0456
      \u04E9\u0437\u0435\u043D \u0431\u0430\u0441\u0442\u0430\u0443 \u0430\u043B\u0430\u0434\u044B"
    audioClip: {fileID: 0}
  - text: "\u0416\u043E\u049B, \u043A\u04E9\u043B \u0442\u0435\u043A \u04E9\u0437\u0435\u043D
      \u049B\u0430\u0431\u044B\u043B\u0434\u0430\u0439\u0434\u044B, \u0431\u0456\u0440\u0430\u049B
      \u0441\u044B\u0440\u0442\u049B\u0430 \u0430\u0493\u044B\u043F \u0448\u044B\u049B\u043F\u0430\u0439\u0434\u044B"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u043B \u0430\u0440\u049B\u044B\u043B\u044B \u0442\u0435\u04A3\u0456\u0437\u0433\u0435
      \u0448\u044B\u0493\u0430\u0442\u044B\u043D \u0431\u04B1\u0493\u0430\u0437 \u0431\u0430\u0440"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u043B\u0434\u0435\u043D \u0436\u0430\u0441\u0430\u043D\u0434\u044B
      \u0430\u0440\u043D\u0430 \u049B\u0430\u0437\u044B\u043B\u0493\u0430\u043D"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 1

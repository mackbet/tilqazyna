  <Answers>k__BackingField:
  - text: "\u0421\u0443\u044B \u04E9\u0442\u0435 \u0441\u0430\u043B\u049B\u044B\u043D"
    audioClip: {fileID: 0}
  - text: "\u0421\u0443\u044B \u0442\u04B1\u0437\u0434\u044B \u0436\u04D9\u043D\u0435
      \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u0434\u0430\u0440\u0493\u0430 \u0431\u0430\u0439"
    audioClip: {fileID: 0}
  - text: "\u0422\u043E\u043B\u049B\u044B\u043D\u0434\u0430\u0440\u044B \u049B\u0430\u0442\u0442\u044B"
    audioClip: {fileID: 0}
  - text: "\u049A\u0430\u043C\u044B\u0441\u044B \u043A\u04E9\u043F \u04E9\u0441\u0435\u0434\u0456"

  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B \u049B\u0430\u0439 \u04E9\u04A3\u0456\u0440\u043B\u0435\u0440\u0434\u0456\u04A3
      \u0448\u0435\u043A\u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430 \u043E\u0440\u043D\u0430\u043B\u0430\u0441\u049B\u0430\u043D?"
    audioClip: {fileID: 0}
  <Answers>k__BackingField:
  - text: "\u0410\u043B\u043C\u0430\u0442\u044B \u0436\u04D9\u043D\u0435 \u049A\u044B\u0437\u044B\u043B\u043E\u0440\u0434\u0430
      \u043E\u0431\u043B\u044B\u0441\u0442\u0430\u0440\u044B"
    audioClip: {fileID: 0}
  - text: "\u0410\u043B\u043C\u0430\u0442\u044B \u0436\u04D9\u043D\u0435 \u0428\u044B\u0493\u044B\u0441
      \u049A\u0430\u0437\u0430\u049B\u0441\u0442\u0430\u043D"
    audioClip: {fileID: 0}
  - text: "\u0422\u04AF\u0440\u043A\u0456\u0441\u0442\u0430\u043D \u0436\u04D9\u043D\u0435
      \u0416\u0430\u043C\u0431\u044B\u043B \u043E\u0431\u043B\u044B\u0441\u0442\u0430\u0440\u044B"
    audioClip: {fileID: 0}
  - text: "\u041F\u0430\u0432\u043B\u043E\u0434\u0430\u0440 \u0436\u04D9\u043D\u0435
      \u0428\u044B\u0493\u044B\u0441 \u049A\u0430\u0437\u0430\u049B\u0441\u0442\u0430\u043D
      \u043E\u0431\u043B\u044B\u0441\u0442\u0430\u0440\u044B"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 1

  <Question>k__BackingField:
    text: "\u0410\u04A3\u044B\u0437\u0434\u0430\u0440\u0434\u044B\u04A3 \u0431\u0456\u0440\u0456\u043D\u0434\u0435
      \u043A\u04E9\u043B \u043C\u0430\u04A3\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u0430\u043C\u044B\u0441
      \u043D\u0435\u0433\u0435 \u0435\u0440\u0435\u043A\u0448\u0435 \u049B\u04B1\u0440\u043C\u0435\u0442\u0442\u0435\u043B\u0435\u0434\u0456?"
    audioClip: {fileID: 8300000, guid: 00c7ccd887318944493420de83e97bc8, type: 3}
  <Answers>k__BackingField:
  - text: "\u0414\u04D9\u0440\u0456 \u0440\u0435\u0442\u0456\u043D\u0434\u0435 \u049B\u043E\u043B\u0434\u0430\u043D\u044B\u043B\u0493\u0430\u043D\u0434\u044B\u0493\u044B
      \u04AF\u0448\u0456\u043D"
    audioClip: {fileID: 0}
  - text: "\u049A\u0430\u0441\u0438\u0435\u0442\u0442\u0456 \u0436\u043E\u043B \u043A\u04E9\u0440\u0441\u0435\u0442\u0443\u0448\u0456
      \u0440\u0435\u0442\u0456\u043D\u0434\u0435 \u0430\u0442\u0430\u043B\u0493\u0430\u043D"
    audioClip: {fileID: 0}
  - text: "\u0428\u0430\u04A3 \u043C\u0435\u043D \u0436\u0435\u043B\u0434\u0435\u043D
      \u049B\u043E\u0440\u0493\u0430\u0439\u0442\u044B\u043D \u049B\u0430\u043B\u049B\u0430\u043D
      \u0431\u043E\u043B\u0493\u0430\u043D"
    audioClip: {fileID: 0}
  - text: "\u049A\u04B1\u0441\u0442\u0430\u0440\u0434\u044B\u04A3 \u049B\u0430\u0441\u0438\u0435\u0442\u0442\u0456
      \u04B1\u044F\u0441\u044B \u0441\u0430\u043D\u0430\u043B\u0493\u0430\u043D"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 3

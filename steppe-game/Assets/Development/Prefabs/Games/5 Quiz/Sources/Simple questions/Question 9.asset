  m_Name: Question 9
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionSimple
  <Question>k__BackingField:
    text: "\u0410\u04A3\u044B\u0437 \u0431\u043E\u0439\u044B\u043D\u0448\u0430 \u0428\u044B\u04A3\u0493\u044B\u0441
      \u0445\u0430\u043D \u04E9\u0437 \u04D9\u0441\u043A\u0435\u0440\u0456\u043D
      \u0410\u043B\u0430\u043A\u04E9\u043B \u0436\u0430\u0493\u0430\u0441\u044B\u043D\u0430
      \u043D\u0435 \u04AF\u0448\u0456\u043D \u0442\u043E\u049B\u0442\u0430\u0442\u049B\u0430\u043D?"
    audioClip: {fileID: 8300000, guid: ace6505b64d78c84da05a105ed4a49fe, type: 3}
  <Answers>k__BackingField:
  - text: "\u0416\u0430\u04A3\u0430 \u049B\u0430\u043B\u0430\u043B\u0430\u0440 \u0441\u0430\u043B\u0443
      \u04AF\u0448\u0456\u043D"
    audioClip: {fileID: 0}
  - text: "\u0421\u0430\u0443\u0434\u0430 \u043A\u0435\u0440\u0443\u0435\u043D\u0434\u0435\u0440\u0456\u043D
      \u043A\u04AF\u0442\u0443 \u04AF\u0448\u0456\u043D"
    audioClip: {fileID: 0}
  - text: "\u0416\u0430\u0443\u044B\u043D\u0433\u0435\u0440\u043B\u0435\u0440\u0456\u043D
      \u0436\u0430\u0440\u0430\u0441\u044B\u043D\u0430\u043D \u0435\u043C\u0434\u0435\u043F,
      \u043A\u04AF\u0448 \u0436\u0438\u043D\u0430\u0443 \u04AF\u0448\u0456\u043D"
    audioClip: {fileID: 0}
  - text: "\u049A\u04B1\u0441 \u0430\u0443\u043B\u0430\u0443\u0493\u0430 \u0448\u044B\u0493\u0443
      \u04AF\u0448\u0456\u043D"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 2

  m_Name: Question 12
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionSimple
  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B\u0434\u0435\u0433\u0456 \u0442\u04AF\u043D\u0433\u0456
      \u043A\u04E9\u0440\u0456\u043D\u0456\u0441?"
    audioClip: {fileID: 0}
  <Answers>k__BackingField:
  - text: "\u0422\u04AF\u043D\u0433\u0456 \u0436\u0430\u0440\u044B\u049B\u0442\u0430\u043D\u0434\u044B\u0440\u0443
      \u0436\u04B1\u043C\u044B\u0441\u0442\u0430\u0440\u044B\u043D\u044B\u04A3 \u043A\u04E9\u043F\u0442\u0456\u0433\u0456"
    audioClip: {fileID: 0}
  - text: "\u0416\u0430\u0440\u049B\u044B\u0440\u0430\u0493\u0430\u043D \u0444\u0438\u0442\u043E\u043F\u043B\u0430\u043D\u043A\u0442\u043E\u043D
      \u043F\u0430\u0439\u0434\u0430 \u0431\u043E\u043B\u0443\u044B"
    audioClip: {fileID: 0}
  - text: "\u0410\u0441\u043F\u0430\u043D\u0434\u0430\u0493\u044B \u0436\u04B1\u043B\u0434\u044B\u0437\u0434\u0430\u0440\u0434\u044B\u04A3
      \u0430\u0439\u049B\u044B\u043D \u043A\u04E9\u0440\u0456\u043D\u0443\u0456"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u043B \u04AF\u0441\u0442\u0456\u043D\u0434\u0435 \u0448\u0430\u043C\u0434\u0430\u0440
      \u043E\u0440\u043D\u0430\u0442\u044B\u043B\u0493\u0430\u043D\u0434\u044B\u049B\u0442\u0430\u043D"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 2

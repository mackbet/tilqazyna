  m_Script: {fileID: 11500000, guid: d38ec61df62fb354b838ebcec8f48a86, type: 3}
  m_Name: Question 9
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestionSimple
  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B \u0441\u0443\u044B\u043D\u044B\u04A3
      \u0442\u04B1\u0437\u0434\u044B\u043B\u044B\u0493\u044B \u043D\u0435\u0433\u0435
      \u04E9\u0437\u0433\u0435\u0448\u0435?"
    audioClip: {fileID: 0}
  <Answers>k__BackingField:
  - text: "\u041A\u04E9\u043B\u0433\u0435 \u0442\u04B1\u0437 \u0437\u0430\u0443\u044B\u0442\u044B
      \u0436\u0430\u049B\u044B\u043D \u043E\u0440\u043D\u0430\u043B\u0430\u0441\u049B\u0430\u043D"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u043B\u0433\u0435 \u0442\u04B1\u0449\u044B \u04E9\u0437\u0435\u043D\u0434\u0435\u0440
      \u0430\u0437 \u049B\u04B1\u044F\u0442\u044B\u043D\u0434\u044B\u049B\u0442\u0430\u043D"
    audioClip: {fileID: 0}
  - text: "\u0416\u0435\u0440 \u0430\u0441\u0442\u044B \u0436\u044B\u043B\u044B\u043C\u0434\u0430\u0440\u044B\u043D\u044B\u04A3
      \u04D9\u0441\u0435\u0440\u0456\u043D\u0435\u043D"
    audioClip: {fileID: 0}
  - text: "\u0416\u0430\u04A3\u0431\u044B\u0440 \u0441\u0443\u044B \u043A\u04E9\u043F
      \u0436\u0438\u043D\u0430\u043B\u0430\u0442\u044B\u043D\u0434\u044B\u049B\u0442\u0430\u043D"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 1

  <Question>k__BackingField:
    text: "\u0410\u04A3\u044B\u0437 \u0431\u043E\u0439\u044B\u043D\u0448\u0430 \u0410\u043B\u0430\u043A\u04E9\u043B
      \u0441\u0443\u044B\u043D\u044B\u04A3 \u0430\u0434\u0430\u043C\u0493\u0430 \u0448\u0438\u043F\u0430\u0441\u044B\u043D
      \u043A\u0456\u043C \u0430\u043B\u0493\u0430\u0448 \u0441\u0435\u0437\u0433\u0435\u043D
      \u0434\u0435\u043B\u0456\u043D\u0435\u0434\u0456?"
    audioClip: {fileID: 8300000, guid: 7bde28155e57ee549afdb4839a24dd80, type: 3}
  <Answers>k__BackingField:
  - text: "\u0416\u0435\u0440\u0433\u0456\u043B\u0456\u043A\u0442\u0456 \u0431\u0430\u043B\u044B\u049B\u0448\u044B"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u0448\u0456\u043F \u0436\u04AF\u0440\u0433\u0435\u043D \u043C\u0430\u043B\u0448\u044B\u043B\u0430\u0440"
    audioClip: {fileID: 0}
  - text: "\u041A\u0435\u0440\u0443\u0435\u043D\u0448\u0456\u043B\u0435\u0440"
    audioClip: {fileID: 0}
  - text: "\u049A\u04B1\u0441 \u0437\u0435\u0440\u0442\u0442\u0435\u0443\u0448\u0456\u043B\u0435\u0440\u0456"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 0

  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B\u0434\u0435 \u0436\u0435\u043B\u0434\u0456\u04A3
      \u0431\u0430\u0493\u044B\u0442\u044B\u043D \u0430\u043D\u044B\u049B\u0442\u0430\u0443
      \u04AF\u0448\u0456\u043D \u0441\u0430\u044F\u0445\u0430\u0442\u0448\u044B\u043B\u0430\u0440
      \u049B\u0430\u043D\u0434\u0430\u0439 \xAB\u0442\u0430\u0431\u0438\u0493\u0438
      \u049B\u04B1\u0440\u0430\u043B\u0434\u044B\xBB \u043F\u0430\u0439\u0434\u0430\u043B\u0430\u043D\u0493\u0430\u043D?"
    audioClip: {fileID: 8300000, guid: b403fbab43d39a64b99aaf42dc0b337f, type: 3}
  <Answers>k__BackingField:
  - text: "\u041A\u04E9\u043B \u0431\u0435\u0442\u0456\u043D\u0434\u0435\u0433\u0456
      \u0442\u043E\u043B\u049B\u044B\u043D\u0434\u0430\u0440\u0434\u044B\u04A3 \u0431\u0430\u0493\u044B\u0442\u044B\u043D\u0430
      \u049B\u0430\u0440\u0430\u043F"
    audioClip: {fileID: 0}
  - text: "\u0421\u0443 \u0442\u04AF\u0441\u0456\u043D\u0456\u04A3 \u04E9\u0437\u0433\u0435\u0440\u0443\u0456\u043D\u0435
      \u049B\u0430\u0440\u0430\u043F"
    audioClip: {fileID: 0}
  - text: "\u0422\u0430\u0443\u043B\u0430\u0440\u0434\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0434\u0435\u0433\u0456
      \u043A\u04AF\u043D\u043D\u0456\u04A3 \u043E\u0440\u043D\u044B\u043D\u0430 \u049B\u0430\u0440\u0430\u043F"
    audioClip: {fileID: 0}
  - text: "\u0421\u0443\u0434\u0430\u0493\u044B \u0436\u0430\u0440\u049B\u044B\u043B\u0434\u044B\u04A3
      \u049B\u0430\u0440\u049B\u044B\u043D\u0434\u044B\u043B\u044B\u0493\u044B\u043D\u0430
      \u049B\u0430\u0440\u0430\u043F"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 0

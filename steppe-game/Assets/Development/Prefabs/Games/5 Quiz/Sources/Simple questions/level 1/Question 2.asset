  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B\u0433\u0435 \u049B\u0430\u0442\u044B\u0441\u0442\u044B
      \u049B\u0430\u043D\u0434\u0430\u0439 \u0430\u04A3\u044B\u0437 \u0436\u0438\u0456
      \u0430\u0439\u0442\u044B\u043B\u0430\u0434\u044B?"
    audioClip: {fileID: 8300000, guid: f1fcea30d36bf3646bac3a70e7904c4c, type: 3}
  <Answers>k__BackingField:
  - text: "\u041A\u04E9\u043B \u0430\u0441\u0442\u044B\u043D\u0434\u0430 \u0430\u043B\u0442\u044B\u043D
      \u049B\u0430\u043B\u0430 \u0431\u0430\u0440"
    audioClip: {fileID: 0}
  - text: "\u0410\u0441\u043F\u0430\u043D\u043D\u0430\u043D \u049B\u04B1\u043B\u0430\u0493\u0430\u043D
      \u0436\u04B1\u043B\u0434\u044B\u0437 \u0441\u0443\u0493\u0430 \u0442\u04AF\u0441\u0456\u043F,
      \u043A\u04E9\u043B\u0433\u0435 \u0430\u0439\u043D\u0430\u043B\u0493\u0430\u043D"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u043B\u0434\u0456 \u0430\u043B\u044B\u043F \u0430\u0439\u0434\u0430\u04BB\u0430\u0440
      \u043A\u04AF\u0437\u0435\u0442\u0435\u0434\u0456"
    audioClip: {fileID: 0}
  - text: "\u041A\u04E9\u043B \u0441\u0443\u044B \u0431\u0456\u0440 \u0442\u04AF\u043D\u0434\u0435
      \u043F\u0430\u0439\u0434\u0430 \u0431\u043E\u043B\u0493\u0430\u043D"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 1

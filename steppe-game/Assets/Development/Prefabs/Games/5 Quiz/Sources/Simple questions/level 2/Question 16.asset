  <Question>k__BackingField:
    text: "\u0410\u043B\u0430\u043A\u04E9\u043B\u0434\u0456\u04A3 \u043C\u0430\u04A3\u044B\u043D\u0434\u0430
      \u049B\u0430\u043D\u0434\u0430\u0439 \u0442\u0430\u0440\u0438\u0445\u0438 \u0435\u0441\u043A\u0435\u0440\u0442\u043A\u0456\u0448\u0442\u0435\u0440
      \u0431\u0430\u0440?"
    audioClip: {fileID: 0}
  <Answers>k__BackingField:
  - text: "\u049A\u043E\u0436\u0430 \u0410\u0445\u043C\u0435\u0442 \u042F\u0441\u0430\u0443\u0438
      \u043A\u0435\u0441\u0435\u043D\u0435\u0441\u0456"
    audioClip: {fileID: 0}
  - text: "\u0422\u0430\u043C\u0493\u0430\u043B\u044B \u0442\u0430\u0441 \u043F\u0435\u0442\u0440\u043E\u0433\u043B\u0438\u0444\u0442\u0435\u0440\u0456"
    audioClip: {fileID: 0}
  - text: "\u0415\u0441\u043A\u0456 \u043A\u0435\u0440\u0443\u0435\u043D \u0436\u043E\u043B\u044B\u043D\u044B\u04A3
      \u0456\u0437\u0434\u0435\u0440\u0456 \u043C\u0435\u043D \u0431\u0435\u043A\u0435\u0442\u0442\u0435\u0440\u0456 "
    audioClip: {fileID: 0}
  - text: "\u041E\u0442\u044B\u0440\u0430\u0440 \u049B\u0430\u043B\u0430\u0448\u044B\u0493\u044B"
    audioClip: {fileID: 0}
  <IndexOfCorrect>k__BackingField: 2

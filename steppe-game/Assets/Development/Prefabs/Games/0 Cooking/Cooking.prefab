  m_text: "\u0421\u04AF\u0437\u0431\u0435\u043D\u0456 \u044B\u0434\u044B\u0441\u049B\u0430
    \u0441\u0430\u043B\u044B\u043F, \u049B\u0430\u043B\u0430\u0443\u044B\u04A3\u0430
    \u049B\u0430\u0440\u0430\u0439 \u0442\u04B1\u0437 \u049B\u043E\u0441\u044B\u043F,
    \u0431\u0456\u0440\u043A\u0435\u043B\u043A\u0456 \u0430\u0440\u0430\u043B\u0430\u0441\u0442\u044B\u0440.
    \u0414\u0430\u0439\u044B\u043D \u0441\u04AF\u0437\u0431\u0435\u043D\u0456 \u049B\u043E\u043B\u0434\u044B

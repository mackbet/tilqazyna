  m_text: "\u0421\u04AF\u0440\u043B\u0435\u043D\u0433\u0435\u043D \u0435\u0442 \u043F\u0435\u043D
    \u049B\u0430\u0437\u044B\u043D\u044B \u0430\u0441\u0443\u0493\u0430 \u0430\u0440\u043D\u0430\u043B\u0493\u0430\u043D
